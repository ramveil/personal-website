---
import Meta from './Meta.astro';
import TopBg from "@/components/ui/TopBg.astro";
import Footer from "@/components/sections/Footer.astro";
import Header from "@/components/sections/Header.astro";
import TrackGa from "@/components/widgets/TrackGa.astro";
interface Props {
	title?: string | undefined;
	description?: string | undefined;
	keywords?: string | undefined;
}

const {
	title,
	description,
	keywords
} = Astro.props;


import "../styles/global.css";
import "aos/dist/aos.css";
import "../styles/aos-custom.css";
import '../styles/article.css';
import '../styles/article-enhancements.css';
import '../styles/portfolio.css';
import '../styles/casefile.css';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <Meta
      title = {title}
      description = {description}
      keywords = {keywords}
    />
    <TrackGa />
    <!-- Used to add dark mode right away, adding here prevents any flicker -->
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('dark_mode');
        if (savedTheme === 'true' || savedTheme === null) {
          document.documentElement.classList.add('dark')
        }
      } catch { document.documentElement.classList.add('dark'); }
    </script>

    <link rel="icon" type="image/x-icon" href="/favicon.png" />
  </head>
  <body class="antialiased bg-bg-primary dark:bg-bg-primary-dark max-w-full overflow-x-hidden">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <TopBg />
    <Header />
    <div id="main-content" tabindex="-1"><slot /></div>
    <Footer />
    <script>
      import "../assets/js/main.js";
    </script>
  </body>
</html>
