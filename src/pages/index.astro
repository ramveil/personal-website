---
import { ArrowUpRight, Box, Flag } from '@lucide/astro';
import SocialCard from '@/components/cards/SocialCard.astro';
import Button from '@/components/ui/Button.astro';
import HeroCard from '@/components/home/HeroCard.astro';
import Layout from '@/layouts/Layout.astro';
import FeaturedWork from '@/components/sections/FeaturedWork.astro';
import CasefileWriteups from '@/components/sections/CasefileWriteups.astro';
import Explore from '@/components/sections/Explore.astro';
---
<Layout title="Ramveil's Portfolio" description="Penetration Tester, CTF Player @ idktheflag and THEM?!, and Bug Hunter for sure." keywords="penetration testing, CTF, bug bounty, security">
  <main class="home-page">
    <section class="site-container hero-section" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>Lifelong Learner</p>
        <h1 id="hero-title">Every detail<br /><em>leaves a trace</em><span class="accent-text">.</span></h1>
        <div class="hero-rule" aria-hidden="true"></div><p class="hero-intro">I'm ramveil.</p>
        <p class="hero-role">Penetration Tester, CTF Player @ <span class="team-name">idktheflag</span> and <span class="team-name">THEM?!</span>, and Bug Hunter for sure.</p>
        <div class="hero-connect">
          <SocialCard />
          <div class="training-links">
            <a class="htb-profile" href="https://profile.hackthebox.com/profile/019c71c4-1227-70fc-b5a5-2c267360780c" target="_blank" rel="noopener noreferrer"><Box size={20} aria-hidden="true" /><span>Hack The Box</span><ArrowUpRight size={16} aria-hidden="true" /></a>
            <a href="https://tryhackme.com/p/ramveil" target="_blank" rel="noopener noreferrer"><Flag size={16} aria-hidden="true" />TryHackMe<ArrowUpRight size={14} aria-hidden="true" /></a>
            <a href="https://x.com/ramveill" target="_blank" rel="noopener noreferrer">X<ArrowUpRight size={14} aria-hidden="true" /></a>
          </div>
        </div>
        <div class="hero-actions">
          <Button url="/writeups" >Explore writeups <ArrowUpRight size={16} /></Button>
        </div>
      </div>
      <HeroCard imageUrl="/images/detective-conan.png" />
    </section>
    <section class="home-section"><CasefileWriteups /></section>
    <section class="home-section case-projects"><FeaturedWork title="Selected projects" description="" limit={5} /><div class="site-container section-end"><a class="text-link" href="/projects">View all projects <ArrowUpRight size={16} /></a></div></section>
    <section class="home-section"><Explore /></section>
  </main>
</Layout>
