---
import Layout from "@/layouts/Layout.astro";
import Button from "@/components/ui/Button.astro";
---

<Layout
  title="Ramveil's Portofolio"
  description="Junior penetration tester, CTF player, and bug hunter."
  keywords="penetration testing, CTF, bug bounty, security"
>
  <main class="site-container mx-auto px-4 pb-16 pt-20 md:pt-24 lg:pt-28">
    <section class="mx-auto max-w-5xl rounded-[28px] border border-primary/20 bg-white/80 p-8 shadow-[0_20px_80px_rgba(61,99,171,0.08)] backdrop-blur-sm dark:border-neutral-800 dark:bg-neutral-950/80 md:p-12">
      <div class="grid gap-10 md:grid-cols-[1.2fr_0.8fr] md:items-center">
        <div>
          <p class="mb-4 text-sm font-medium uppercase tracking-[0.24em] text-primary/70 dark:text-primary-light/80">
            ramveil.com
          </p>
          <h1 class="font-brand text-4xl leading-tight text-neutral-900 dark:text-white md:text-5xl lg:text-6xl">
            Junior penetration tester, CTF player, and bug hunter.
          </h1>
          <p class="mt-5 max-w-2xl text-base leading-7 text-neutral-700 dark:text-neutral-300">
            The homepage was trimmed back to stable markup so the root route can serve cleanly again.
            Writeups, projects, and the about page are still available below while I keep the rest of the site safe.
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <Button url="/writeups" type="fill">Read writeups</Button>
            <Button url="/projects">View projects</Button>
            <Button url="/about">About me</Button>
          </div>
        </div>

        <div class="rounded-[24px] border border-dashed border-primary/25 bg-bg-secondary/70 p-6 dark:border-neutral-700 dark:bg-neutral-900/70">
          <img
            src="/assets/avatar.png"
            alt="ramveil avatar"
            class="mx-auto h-28 w-28 rounded-full object-cover ring-4 ring-white/80 dark:ring-neutral-800"
          />
          <div class="mt-6 space-y-4">
            <div>
              <p class="text-xs uppercase tracking-[0.18em] text-neutral-500 dark:text-neutral-400">
                Focus
              </p>
              <p class="mt-1 text-sm text-neutral-800 dark:text-neutral-200">
                Web exploitation, bug bounty, CTFs, and practical offensive security research.
              </p>
            </div>
            <div>
              <p class="text-xs uppercase tracking-[0.18em] text-neutral-500 dark:text-neutral-400">
                Fast links
              </p>
              <ul class="mt-2 space-y-2 text-sm text-neutral-700 dark:text-neutral-300">
                <li><a href="/blogs" class="hover:text-primary dark:hover:text-primary-light">Blogs</a></li>
                <li><a href="/rss.xml" class="hover:text-primary dark:hover:text-primary-light">RSS feed</a></li>
                <li><a href="/assets/resume/SetyaRamadan_CV.pdf?v=20260416" class="hover:text-primary dark:hover:text-primary-light">Resume</a></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
