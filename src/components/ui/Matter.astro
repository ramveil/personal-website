---
import bounds from '@/collections/stack-bounds.json';
const tools = [
  ['All', 'Development tools'], ['ArchLinux', 'Arch Linux'], ['burpsuite', 'Burp Suite'],
  ['css', 'CSS'], ['Figma', 'Figma'], ['html', 'HTML'], ['js', 'JavaScript'],
  ['kali-linux', 'Kali Linux'], ['Laravel', 'Laravel'], ['linux', 'Linux'],
  ['metasploit', 'Metasploit'], ['Python', 'Python'], ['TypeScript', 'TypeScript'],
  ['VIM', 'Vim'], ['vscode', 'Visual Studio Code'], ['windows', 'Windows'],
];
---

<div class="matter-wrapper">
  <div class="stack-fallback" role="list" aria-label="Tool stack">
    {tools.map(([file, label]) => {
      const b = bounds[file as keyof typeof bounds];
      return <span role="listitem"><span class="tool-art" style={`aspect-ratio:${b.w}/${b.h}; --tool-ratio:${b.w/b.h}; --art-width:${b.width/b.w*100}%; --art-height:${b.height/b.h*100}%; --art-left:${-b.x/b.w*100}%; --art-top:${-b.y/b.h*100}%;`} data-ratio={b.w/b.h}><img src={`/assets/stack/${file}.png`} alt={label} width={b.width} height={b.height} loading="lazy" /></span></span>;
    })}
  </div>
  <div id="matter" class="tricks-spacer zIndex-3d">
    <div class="tricks-view" id="tricks-view"></div>
  </div>
  <div class="tricks-matter zIndex-3d">
    <div class="tricks-canvas"></div>
    <div class="tricks-elements"></div>
  </div>
</div>

<script>
import Matter from 'matter-js';
const preference = matchMedia('(prefers-reduced-motion: reduce)');
document.querySelectorAll<HTMLElement>('.matter-wrapper').forEach(wrapper => {
  const host = wrapper.querySelector<HTMLElement>('.tricks-canvas')!;
  const layer = wrapper.querySelector<HTMLElement>('.tricks-elements')!;
  let started = false;
  let visible = false;
  let runner: Matter.Runner | undefined;
  const sync = () => {
    if (runner) runner.enabled = visible && !document.hidden && !preference.matches;
    wrapper.classList.toggle('stack-reduced', preference.matches);
    if (visible && !preference.matches && !started) void init();
  };
  new IntersectionObserver(entries => { visible = entries[0].isIntersecting; sync(); }).observe(wrapper);
  document.addEventListener('visibilitychange', sync);
  preference.addEventListener('change', sync);
  async function init() {
    started = true;
    const originals = Array.from(wrapper.querySelectorAll<HTMLElement>('.stack-fallback .tool-art'));
    try {
      await Promise.all(originals.map(art => {
        const preload = new Image(); preload.src = art.querySelector('img')!.src; return preload.decode();
      }));
    } catch { return; } // Keep the complete fallback if any image is unavailable.
    const engine = Matter.Engine.create();
    const mouse = Matter.Mouse.create(host);
    const events = mouse as Matter.Mouse & { mousewheel: EventListener; mousedown: EventListener; mousemove: EventListener; mouseup: EventListener };
    ['wheel', 'mousewheel', 'DOMMouseScroll'].forEach(name => host.removeEventListener(name, events.mousewheel));
    // A vertical touch gesture scrolls; a horizontal gesture drags a tool.
    host.removeEventListener('touchstart', events.mousedown);
    host.removeEventListener('touchmove', events.mousemove);
    host.removeEventListener('touchend', events.mouseup);
    host.style.touchAction = 'pan-y';
    let touchId: number | null = null;
    const position = (event: PointerEvent) => {
      const rect = host.getBoundingClientRect();
      mouse.position.x = event.clientX - rect.left;
      mouse.position.y = event.clientY - rect.top;
    };
    host.addEventListener('pointerdown', event => {
      if (event.pointerType !== 'touch') return;
      touchId = event.pointerId; position(event); mouse.button = 0;
    });
    host.addEventListener('pointermove', event => { if (touchId === event.pointerId) position(event); });
    const release = () => { touchId = null; mouse.button = -1; };
    host.addEventListener('pointercancel', release); host.addEventListener('pointerup', release);
    const constraint = Matter.MouseConstraint.create(engine, {mouse, constraint: {stiffness: .3, render: {visible: false}}});
    Matter.Composite.add(engine.world, constraint);
    let walls: Matter.Body[] = [];
    const icons = originals.map(art => {
      const el = document.createElement('div'); el.className = 'tricks-circle';
      const picture = art.cloneNode(true) as HTMLElement;
      picture.querySelector('img')!.loading = 'eager'; el.append(picture); layer.append(el);
      const body = Matter.Bodies.rectangle(0, 0, 1, 1, {restitution: .25, friction: .25, frictionAir: .025});
      Matter.Composite.add(engine.world, body);
      return {el, body, ratio: Number(art.dataset.ratio) || 1, w: 1, h: 1};
    });
    const resize = () => {
      const {width: w, height: h} = wrapper.getBoundingClientRect();
      if (!w || !h) return;
      walls.forEach(wall => Matter.Composite.remove(engine.world, wall));
      walls = [Matter.Bodies.rectangle(w/2,h+20,w+80,40,{isStatic:true}), Matter.Bodies.rectangle(-20,h/2,40,h+80,{isStatic:true}), Matter.Bodies.rectangle(w+20,h/2,40,h+80,{isStatic:true}), Matter.Bodies.rectangle(w/2,-20,w+80,40,{isStatic:true})];
      Matter.Composite.add(engine.world, walls);
      const columns = w < 500 ? 3 : w < 850 ? 4 : 6;
      const cellW = w/columns, cellH = h/Math.ceil(icons.length/columns);
      icons.forEach((icon,i) => {
        const iw = Math.min(cellW*.88, cellH*.86*icon.ratio, 220);
        const ih = iw/icon.ratio;
        Matter.Body.setAngle(icon.body,0);
        Matter.Body.scale(icon.body,iw/icon.w,ih/icon.h);
        icon.w=iw; icon.h=ih;
        icon.el.style.width=iw+'px'; icon.el.style.height=ih+'px';
        Matter.Body.setPosition(icon.body,{x:(i%columns+.5)*cellW,y:(Math.floor(i/columns)+.5)*cellH});
        Matter.Body.setVelocity(icon.body,{x:0,y:0}); Matter.Body.setAngularVelocity(icon.body,0);
      });
      draw();
    };
    const draw = () => icons.forEach(icon => {
      const {x,y}=icon.body.position;
      icon.el.style.transform=`translate(${x-icon.w/2}px,${y-icon.h/2}px) rotate(${icon.body.angle}rad)`;
    });
    new ResizeObserver(resize).observe(wrapper);
    resize();
    Matter.Events.on(engine,'afterUpdate',draw);
    wrapper.classList.add('stack-initialized');
    runner = Matter.Runner.create(); Matter.Runner.run(runner,engine); sync();
  }
});
</script>

<style is:global>
/* tricks css */
.matter-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
}
.stack-fallback { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; align-content: center; height: 100%; padding: 16px; }
.stack-fallback > span { display: flex; align-items: center; justify-content: center; min-width: 0; min-height: 0; }
.tool-art { display: block; position: relative; overflow: hidden; }
.tool-art img, .matter-wrapper .tool-art img { position: absolute; width: var(--art-width); height: var(--art-height); max-width: none; max-height: none; left: var(--art-left); top: var(--art-top); object-fit: fill; }
.tricks-circle > .tool-art { width: 100%; height: 100%; }
.stack-initialized:not(.stack-reduced) .stack-fallback { visibility: hidden; }
.stack-reduced .tricks-matter { visibility: hidden; }

#matter {
  position: relative;
  width: 100%;
  height: 100%;
}

.tricks-spacer {
  position: relative;
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  width: 100%;
  height: 100%;
  -webkit-box-pack: center;
  -webkit-justify-content: center;
  -ms-flex-pack: center;
  justify-content: center;
  -webkit-box-align: center;
  -webkit-align-items: center;
  -ms-flex-align: center;
  align-items: center;
}

.tricks-view {
  position: absolute;
  left: 0%;
  top: auto;
  right: 0%;
  bottom: 0%;
  height: 99%;
  margin-bottom: 20px;
}

.tricks-matter {
  position: absolute;
  left: 0%;
  right: 0%;
  bottom: 0%;
  z-index: 1;
  width: 100%;
  height: 100%;
}


.tricks-canvas {
  position: absolute;
  width: 100%;
  height: 100%;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  cursor: -webkit-grab;
  cursor: grab;
}

.tricks-elements,
.tricks-spacer {
  pointer-events: none;
}


.tricks-circle {
  position: absolute;
  overflow: hidden;
  background: transparent;
  will-change: transform;
}


.tricks-circle img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

</style>
