---
export interface Props {
  url: string;
  type?: 'solid' | 'fill' | 'disabled';
  className?: string;
  target?: '_blank' | '_self' | '_parent' | '_top';
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  download?: boolean;
}
const { url, type = 'solid', className = '', target = '_self', size = 'md', download = false } = Astro.props;
---
<a href={type === 'disabled' ? undefined : url} target={target} rel={target === '_blank' ? 'noopener noreferrer' : undefined}
  download={download || undefined} aria-disabled={type === 'disabled' ? 'true' : undefined}
  class:list={['site-button', `button-${type}`, `button-${size}`, className]}><slot /></a>
