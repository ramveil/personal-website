---
import { getCollection } from 'astro:content';
import { ArrowUpRight, FileText } from '@lucide/astro';
const sorted = (await getCollection('writeups')).sort((a,b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const lead = sorted.find(post => post.data.featured) || sorted[0];
const others = sorted.filter(post => post.id !== lead?.id).slice(0,2);
const date = (value: Date) => value.toLocaleDateString('en-US', {year:'numeric',month:'short',day:'numeric'});
---
<section class="site-container case-writeups">
  <div class="archive-heading"><h2><FileText size={20} /> Latest writeups</h2><span class="eyebrow">Notes from the field</span></div>
  {lead && <div class="editorial-writeups">
    <article class="lead-writeup">
      <a href={`/writeups/${lead.id}`} class="lead-cover" tabindex="-1" aria-hidden="true"><img src={lead.data.img} alt={lead.data.img_alt || ''} width="720" height="450" loading="lazy" />{lead.data.featured && <span class="featured-label">Featured</span>}</a>
      <time datetime={lead.data.publishDate.toISOString()}>{date(lead.data.publishDate)}</time>
      <h3><a href={`/writeups/${lead.id}`}>{lead.data.title}</a></h3>
      <p>{lead.data.description}</p>
      <a class="text-link" href={`/writeups/${lead.id}`} aria-label={`Read ${lead.data.title}`}>Read writeup <ArrowUpRight size={16} /></a>
    </article>
    <div class="companion-writeups">{others.map(post => <article class="companion-writeup">
      <img src={post.data.img} alt={post.data.img_alt || ''} width="240" height="180" loading="lazy" />
      <div><time datetime={post.data.publishDate.toISOString()}>{date(post.data.publishDate)}</time><h3><a href={`/writeups/${post.id}`}>{post.data.title}</a></h3></div>
      <ArrowUpRight class="companion-arrow" size={18} aria-hidden="true" />
    </article>)}<div class="section-end"><a class="text-link" href="/writeups">View all writeups <ArrowUpRight size={16} /></a></div></div>
  </div>}
</section>
