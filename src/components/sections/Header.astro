---
import { Moon, Sun, Menu, X } from '@lucide/astro';
import menus from '@/collections/menu.json';
import Logo from '@/components/ui/Logo.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header id="header" class="site-header">
  <div class="site-container header-inner">
    <div class="masthead-brand"><Logo /></div>
    <nav id="menu" class="site-nav" aria-label="Main navigation">
      {menus.map(menu => <a href={menu.url} aria-current={(menu.url === '/' ? path === '/' : path.startsWith(menu.url)) ? 'page' : undefined}>{menu.name}</a>)}
    </nav>
    <div class="header-actions">
      <button id="darkToggle" class="icon-button theme-toggle" type="button" aria-label="Switch to light theme"><Sun class="theme-sun" size={18} /><Moon class="theme-moon" size={18} /><span class="theme-switch-track" aria-hidden="true"></span></button>
      <button id="menuToggle" class="icon-button menu-toggle" type="button" aria-label="Open navigation" aria-controls="menu" aria-expanded="false"><Menu class="menu-open-icon" size={21} /><X class="menu-close-icon" size={21} /></button>
    </div>
  </div>
</header>
<noscript>
  <style>
    .theme-toggle, .menu-toggle { display: none !important; }
    @media (max-width: 767px) {
      .header-inner { flex-wrap: wrap; padding-block: 18px; }
      .site-nav { display: flex; position: static; flex-wrap: wrap; width: 100%; order: 3; padding: 0; box-shadow: none; border: 0; gap: 4px 14px; }
      .site-nav a { font-size: 13px; padding: 8px 0; }
    }
  </style>
</noscript>
