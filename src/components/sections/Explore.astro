---
import { Wrench } from '@lucide/astro';
import Matter from '@/components/ui/Matter.astro';
---
<section class="site-container">
  <div class="stack-panel">
    <div class="stack-heading"><h2><Wrench size={20} /> Tool stack</h2><span>Grab &amp; drag ↗</span></div>
    <div class="tool-stack-box"><Matter /></div>
  </div>
  <div class="drawer-handle" aria-hidden="true"><span></span></div>
  <div class="stack-note-wrap"><p class="stack-note">The tools change.<br />Curiosity stays.</p><svg class="note-arrow" width="110" height="65" viewBox="0 0 110 65" fill="none" aria-hidden="true"><path d="M4 54C48 61 71 36 91 12M71 16l22-7-1 22" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
</section>
