---
import social from '@/collections/social.json';
const { displaySocialIds = [] } = Astro.props;
const filteredSocial = social.filter(item => item.isShow !== false && (!displaySocialIds.length || displaySocialIds.includes(item.id)));
---
<div class="connect-deck" aria-label="Connect with ramveil">
  {filteredSocial.map((item, index) => <a class="connect-card" href={item.url} target="_blank" rel="noopener noreferrer" title={`${item.name} — ${item.username}`} aria-label={`${item.name} — ${item.username}`} style={`--card-tilt: ${[-7, 3, -3, 5, -4, 6][index % 6]}deg;`}>
    <img src={item.image} alt="" width="72" height="72" />
    <span>{item.name}</span>
  </a>)}
</div>
