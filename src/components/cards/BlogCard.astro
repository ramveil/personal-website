---
import { ArrowUpRight, FileText } from '@lucide/astro';
const { content, layout = 'vertical', 'data-aos': dataAos, 'data-aos-delay': dataAosDelay } = Astro.props;
const { title, description, publishDate, tags = [], img, img_alt, slug, link } = content;
const date = new Date(publishDate);
const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const postLink = link || `/writeups/${slug}`;
---
<article class:list={['journal-card', { 'journal-horizontal': layout === 'horizontal' }]} data-aos={dataAos} data-aos-delay={dataAosDelay}>
  <a href={postLink} class="journal-image" tabindex="-1" aria-hidden="true">
    {img ? <img src={img} alt={img_alt || ''} loading="lazy" width="720" height="450" /> : <FileText size={40} />}
  </a>
  <div class="journal-copy">
    <div class="journal-meta"><time datetime={date.toISOString()}>{formattedDate}</time>{tags.length > 0 && <><span aria-hidden="true">/</span><span class="journal-tag">{tags[0]}</span></>}</div>
    <h2><a href={postLink}>{title}</a></h2>
    {description && <p>{description}</p>}
    <a href={postLink} class="text-link" aria-label={`Read ${title}`}>Read the story <ArrowUpRight size={14} /></a>
  </div>
</article>
