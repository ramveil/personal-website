---
interface Props { title?: string; description?: string; tags?: string[]; className?: string; }
const { title, description, tags = [], className = '' } = Astro.props;
---
<div class:list={['page-heading', className]}>
  <p class="eyebrow">ramveil / {title?.toLowerCase()}</p>
  <h1>{title}<span class="accent-text">.</span></h1>
  {description && <p class="page-description">{description}</p>}
  {tags.length > 0 && <div class="tag-list">{tags.map(tag => <span>{tag}</span>)}</div>}
</div>
